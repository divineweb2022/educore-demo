{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/edusuite-demo run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
